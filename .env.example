# Read-only login used for every page read (migration 014). Neon pooled host.
DATABASE_URL=postgresql://app_web:<password>@<host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require

# Write login (017), used only by src/lib/db-write.ts inside authenticated admin handlers.
ADMIN_DATABASE_URL=postgresql://app_admin_user:<password>@<host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require

# Signs session JWTs. At least 32 characters; generate with: openssl rand -base64 48
JWT_SECRET=
